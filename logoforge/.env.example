# All of these are needed for the "AI generate" tab. The rest of the site works without them.

# 1) Anthropic (https://console.anthropic.com) - server only
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# 2) Supabase (https://supabase.com > your project > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET: never prefix with NEXT_PUBLIC_ and never commit it
SUPABASE_SERVICE_ROLE_KEY=

# Designs per user per day (default 3)
DAILY_LIMIT=3
